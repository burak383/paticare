PORT=4000

# Geliştirme sırasında bu varsayılan değerle çalışır, ama bu değer herkese açık
# olduğu için production'da mutlaka değiştirilmeli — aksi halde NODE_ENV=production
# ile başlatıldığında sunucu kasıtlı olarak açılmayı reddeder (bkz. src/middleware/auth.js).
# Rastgele bir değer üretmek için: openssl rand -hex 32
JWT_SECRET=paticare-dev-secret-change-me

# production'a taşırken NODE_ENV=production olarak ayarla (yukarıdaki JWT_SECRET
# kontrolünü ve Express'in üretim optimizasyonlarını devreye sokar).
NODE_ENV=development

# Virgülle ayrılmış izinli web origin listesi (örn. https://app.paticare.com).
# Boş bırakılırsa tüm origin'lere izin verilir — mobil/simülatörden erişim için
# yerelde bu uygundur, ama herkese açık bir sunucuya deploy ederken kısıtlanmalı.
CORS_ORIGIN=

# Google ile giriş için gerekli — Google Cloud Console'da bir OAuth istemcisi
# oluşturup buraya istemci kimliğini (Client ID) yapıştır. Boş bırakılırsa
# Google ile giriş butonu, kullanıcıya bunun yapılandırılmadığını söyleyen bir
# uyarı gösterir (uygulama çökmez). Bu, ANDROİD istemcisi (paket adı + SHA-1
# ile doğrulanır) — iOS için ayrı bir istemci gerekiyor, aşağıya bak.
GOOGLE_CLIENT_ID=

# iOS için Google ile giriş — Android'den AYRI bir OAuth istemci türü (iOS,
# bundle identifier ile doğrulanır — SHA-1 yok). Google Cloud Console'da
# "iOS" tipinde yeni bir istemci oluşturup bundle identifier'ı
# (mobile/app.json → expo.ios.bundleIdentifier, örn. app.paticare.mobile)
# gir, üretilen Client ID'yi buraya yapıştır. Mobil taraftaki karşılığı
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID (bkz. eas.json). Boş bırakılırsa iOS'ta
# Google girişi kabul edilmez, Android etkilenmez.
GOOGLE_IOS_CLIENT_ID=

# Apple ile giriş için gerekli (iOS'ta zorunlu — Apple, Google gibi bir
# üçüncü taraf girişi sunan uygulamaların Sign in with Apple'ı da sunmasını
# şart koşuyor). Değeri uygulamanın bundle identifier'ı — mobile/app.json'daki
# expo.ios.bundleIdentifier ile birebir aynı olmalı (örn. app.paticare.mobile).
# Ayrıca App Store Connect'te "Sign In with Apple" özelliğinin App ID'nde
# etkinleştirilmiş olması gerekiyor. Boş bırakılırsa Apple ile giriş
# endpoint'i, yapılandırılmadığını söyleyen bir hata döner (uygulama çökmez).
APPLE_BUNDLE_ID=

# Şifre sıfırlama kodunu gerçek e-posta ile göndermek için Resend
# (resend.com) kullanılıyor — ücretsiz planı yeterli. API anahtarını
# resend.com/api-keys'ten al. Boş bırakılırsa forgot-password endpoint'i eski
# demo davranışına döner: kod gerçek e-posta gitmeden doğrudan API yanıtında
# (devCode) döner — yerel geliştirme için, gerçek e-posta kurulmadan da
# çalışsın diye.
RESEND_API_KEY=

# Resend'de doğrulanmış bir gönderen adresi/alan adı gerekir (resend.com/domains).
# Kendi alan adını doğrulamadıysan Resend'in test modunda verdiği
# "onboarding@resend.dev" adresini kullanabilirsin (sadece Resend hesabına
# kayıtlı e-postaya gönderim yapar — gerçek kullanıcılara göndermek için kendi
# alan adını doğrulaman gerekir).
RESEND_FROM_EMAIL=PatiCare <onboarding@resend.dev>

# Tara ekranındaki kamera taraması için gerçek görüntü tanıma — Google Cloud
# Console'da bir proje oluşturup Vision API'yi etkinleştir, sonra bir API
# anahtarı üret (ve Vision API ile sınırla). Boş bırakılırsa /api/products/scan
# eski demo davranışına döner: barkod/isme göre eşleştirir, yoksa örnek bir
# ürün gösterir (bkz. src/vision.js, src/routes/products.js). İlk 1000
# birim/ay ücretsiz, sonrası ~$1,50/1000 birim (cloud.google.com/vision/pricing).
GOOGLE_VISION_API_KEY=

# PatiCare Plus'ın gerçek satın alma (RevenueCat) webhook'unu doğrulamak
# için — RevenueCat panelinde Project settings > Webhooks altında bu
# backend'in genel adresi + /api/subscription/revenuecat-webhook eklenip
# "Authorization header value" alanına buradakiyle AYNI rastgele değeri
# yazmalısın. Boş bırakılırsa webhook endpoint'i 503 döner (bkz.
# src/routes/subscription.js). Mobil taraftaki RevenueCat API anahtarları
# (mobile/src/purchases.ts) için ayrıca bkz. görev #52.
REVENUECAT_WEBHOOK_AUTH_HEADER=
