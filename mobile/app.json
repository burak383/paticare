{
  "expo": {
    "name": "PatiCare",
    "slug": "paticare",
    "owner": "burak38",
    "scheme": "paticare",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#F7FBF8",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.paticare.mobile",
      "buildNumber": "3",
      "infoPlist": {
        "NSFaceIDUsageDescription": "PatiCare, tekrar giriş yaptığında hesabını hızlıca ve güvenle açman için Face ID kullanır.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.paticare.mobile",
      "versionCode": 13,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7FBF8"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "PatiCare, tekrar giriş yaptığında hesabını hızlıca ve güvenle açman için Face ID kullanır."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PatiCare, evcil hayvanının profil fotoğrafını seçmen için fotoğraflarına erişim ister.",
          "cameraPermission": "PatiCare, ürün etiketini tarayabilmen için kameranıza erişim ister.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#087F5B",
          "sounds": [
            "./assets/sounds/gentle_paw.wav",
            "./assets/sounds/bell.wav",
            "./assets/sounds/ping.wav"
          ]
        }
      ],
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "1688acd7-e3da-46c9-b135-762c45fd067e"
      }
    }
  }
}
